# QuR Tag local development. The app needs no secrets in the browser: it calls its own
# server functions at /api, which `npm run dev:local` runs against a throwaway database
# (see README.md). Vite forwards /api to QURTAG_API_PROXY.
QURTAG_API_PROXY=http://127.0.0.1:56861

# Show the switched-off features (src/lib/features.ts) for local work only.
# VITE_QURTAG_LABS=1

# Email (server side only, set in Vercel; never a VITE_ variable). Without a key, password
# reset answers "We couldn't send the email right now" and nothing is sent.
# RESEND_API_KEY=
# QURTAG_EMAIL_FROM="QuR Tag <no-reply@qurtag.com>"
