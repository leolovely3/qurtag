{
  "redirects": [
    { "source": "/fb", "destination": "/?utm_source=facebook&utm_medium=social&utm_campaign=profile", "statusCode": 302 },
    { "source": "/ig", "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=profile", "statusCode": 302 },
    { "source": "/x", "destination": "/?utm_source=x&utm_medium=social&utm_campaign=profile", "statusCode": 302 },
    { "source": "/li", "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=profile", "statusCode": 302 },
    { "source": "/tt", "destination": "/?utm_source=tiktok&utm_medium=social&utm_campaign=profile", "statusCode": 302 },
    { "source": "/yt", "destination": "/?utm_source=youtube&utm_medium=social&utm_campaign=profile", "statusCode": 302 },
    { "source": "/th", "destination": "/?utm_source=threads&utm_medium=social&utm_campaign=profile", "statusCode": 302 },
    { "source": "/rd", "destination": "/?utm_source=reddit&utm_medium=social&utm_campaign=profile", "statusCode": 302 }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth" },
    { "source": "/api/data/(.*)", "destination": "/api/data" },
    { "source": "/api/fn/(.*)", "destination": "/api/fn" },
    { "source": "/api/jobs/(.*)", "destination": "/api/jobs" },
    { "source": "/((?=[A-Za-z2-9]*[2-9])[2-9A-HJ-KM-NP-Za-hj-km-np-z]{5,6})", "destination": "/api/fn?go=$1" },
    { "source": "/app", "destination": "/app-shell" },
    { "source": "/app/(.*)", "destination": "/app-shell" },
    { "source": "/start", "destination": "/app-shell" },
    { "source": "/start/(.*)", "destination": "/app-shell" },
    { "source": "/forgot-password", "destination": "/app-shell" },
    { "source": "/reset-password", "destination": "/app-shell" },
    { "source": "/auth/callback", "destination": "/app-shell" },
    { "source": "/join/(.*)", "destination": "/app-shell" },
    { "source": "/find", "destination": "/app-shell" },
    { "source": "/reply", "destination": "/app-shell" },
    { "source": "/find/(.*)", "destination": "/app-shell" },
    { "source": "/partners", "destination": "/app-shell" },
    { "source": "/partners/(.*)", "destination": "/app-shell" }
  ],
  "functions": {
    "api/jobs/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/jobs/daily", "schedule": "0 5 * * *" },
    { "path": "/api/jobs/outbox", "schedule": "*/5 * * * *" }
  ],
  "headers": [
    {
      "source": "/join/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/reply",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/find/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
